{
  "name": "agentskills",
  "version": "0.1.0",
  "description": "Open library of portable skills for AI agents. Procedural knowledge any agent can discover and load on demand \u2014 via MCP, CLI, or plain markdown.",
  "keywords": [
    "agent",
    "agents",
    "ai-agent",
    "agent-skills",
    "skills",
    "skill",
    "mcp",
    "model-context-protocol",
    "llm",
    "claude",
    "cursor",
    "codex",
    "prompt-engineering",
    "agentic",
    "ai-tools",
    "context-engineering"
  ],
  "homepage": "https://github.com/roshaninfordham/agentskills#readme",
  "bugs": "https://github.com/roshaninfordham/agentskills/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roshaninfordham/agentskills.git"
  },
  "license": "MIT",
  "author": "Roshan Sharma",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agentskills": "src/cli.js"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "skills",
    "registry.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "registry": "node scripts/build-registry.js",
    "validate": "node scripts/validate.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run registry && npm run validate && npm test"
  }
}
